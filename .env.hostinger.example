# Kopjoni këto vlera në Hostinger Node.js → Environment variables
# (mos e ngarkoni këtë skedar me fjalëkalime reale në Git)

NODE_ENV=production
TRUST_PROXY=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_user
DB_PASSWORD=your_mysql_password
DB_NAME=u123456789_mobileshop

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

FRONTEND_URL=https://mobileshop.fun

ADMIN_EMAIL=admin@mobileshop.fun
ADMIN_PASSWORD=YourStrongAdminPassword123!

# SMTP (opsionale — për email aktivizimi)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@mobileshop.fun
SMTP_PASS=your_mailbox_password

# Vetëm për build të React në PC (jo në Node panel):
# REACT_APP_API_URL=https://api.mobileshop.fun
