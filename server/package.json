{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "start:production": "node server.production.js",
    "dev": "nodemon server.js",
    "ssl:generate": "node scripts/generate-cert.js",
    "test": "jest --runInBand --testPathIgnorePatterns=__tests__/integration",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand --testPathIgnorePatterns=__tests__/integration",
    "test:integration": "jest __tests__/integration --runInBand",
    "test:integration:tc": "cross-env USE_TESTCONTAINERS=true TEST_DB_USER=testuser TEST_DB_PASSWORD=testpass TEST_DB_NAME=mobileshop_test jest __tests__/integration/api.integration.test.js --runInBand",
    "test:docker": "docker-compose -f __tests__/integration/docker-compose.test.yml up --build --abort-on-container-exit",
    "test:newman": "node ../tests/newman/run-api-tests.js",
    "test:api": "npm run test && npm run test:integration && npm run test:newman",
    "test:all": "npm run test && npm run test:integration && npm run test:newman",
    "test:performance": "cd ../tests/performance && python run-load-tests.py --type basic",
    "test:performance:all": "cd ../tests/performance && python run-load-tests.py --type all",
    "test:e2e": "cd ../client && npm run e2e",
    "test:complete": "npm run test && npm run test:integration && npm run test:newman && cd ../client && npm run e2e && cd ../tests/performance && python run-load-tests.py --type basic"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "express-status-monitor": "^1.3.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^3.12.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.3.3",
    "mysql2": "^3.22.3",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "sequelize": "^6.37.8",
    "selfsigned": "^3.0.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "newman": "^6.1.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4",
    "testcontainers": "^11.8.1"
  },
  "description": ""
}
