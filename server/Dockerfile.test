FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy test files and source code
COPY . .

# Install test dependencies
RUN npm install --no-save jest supertest mysql2

# Create test database schema
COPY __tests__/integration/test-schema.sql /tmp/test-schema.sql

# Expose port for test runner
EXPOSE 3001

# Default command
CMD ["npm", "run", "test:integration"]
